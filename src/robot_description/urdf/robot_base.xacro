<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- CAD meshes are exported from FreeCAD in millimetres; URDF works in metres. -->
    <xacro:property name="mm_to_m" value="0.001" />

    <xacro:property name="base_length" value="0.5" />
    <xacro:property name="base_width" value="0.5" />
    <xacro:property name="link_1_length" value="0.3" />
    <xacro:property name="link_1_radius" value="0.1" />
    <xacro:property name="link_2_length" value="0.5" />
    <xacro:property name="link_2_radius" value="0.1" />
    <xacro:property name="base_height" value="0.2" />
    <xacro:property name="link_3_length" value="0.2" />
    <xacro:property name="link_3_radius" value="0.1" />
    <xacro:property name="link_4_length" value="0.3" />
    <xacro:property name="link_4_radius" value="0.12" />
    <xacro:property name="wrist_2_link_length" value="0.08" />
    <xacro:property name="wrist_2_link_width" value="0.06" />
    <xacro:property name="wrist_2_link_height" value="0.04" />
    <xacro:property name="finger_length" value="0.06" />
    <xacro:property name="finger_width" value="0.01" />
    <xacro:property name="finger_height" value="0.02" />
    <xacro:property name="finger_gap" value="0.025" />
    <xacro:property name="finger_travel" value="0.02" />
    <xacro:property name="tool_link_length" value="0.08" />
    <xacro:property name="tool_link_radius" value="0.05" />


    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="package://robot_description/meshes/assemblybase.stl" scale="${mm_to_m} ${mm_to_m} ${mm_to_m}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="0.3236 0.2000 0.0980"/>
            </geometry>
            <origin xyz="-0.0618 0.0000 0.0490" rpy="0 0 0" />
        </collision>
    </link>

    <link name="link_1">
        <visual>
            <geometry>
                <mesh filename="package://robot_description/meshes/assemblyart1.stl" scale="${mm_to_m} ${mm_to_m} ${mm_to_m}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="red" />
        </visual>
        <!-- Cylinder is capped just below the shoulder joint (z=0.123) so it
             does not protrude above the pivot and clip link_3 when the
             shoulder tilts. The yoke above the joint is covered by link_2. -->
        <collision>
            <geometry>
                <cylinder length="0.1500" radius="0.0770" />
            </geometry>
            <origin xyz="0 0 0.0450" rpy="0 0 0" />
        </collision>
    </link>


    <link name="link_2">
        <visual>
            <geometry>
                <mesh filename="package://robot_description/meshes/assemblyart2.stl" scale="${mm_to_m} ${mm_to_m} ${mm_to_m}" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.5708 0 3.1416" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_description/meshes/assemblyart2.stl" scale="${mm_to_m} ${mm_to_m} ${mm_to_m}" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.5708 0 3.1416" />
        </collision>
    </link>

    <link name="link_3">
        <visual>
            <geometry>
                <mesh filename="package://robot_description/meshes/assemblyart3.stl" scale="${mm_to_m} ${mm_to_m} ${mm_to_m}" />
            </geometry>
            <origin xyz="0 0 0.0815" rpy="0 3.1416 0" />
            <material name="red" />
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.1490" radius="0.0680" />
            </geometry>
            <origin xyz="0 0 0.0035" rpy="0 0 0" />
        </collision>
    </link>

    <link name="link_4">
        <visual>    
            <geometry>
                <mesh filename="package://robot_description/meshes/assemblyart4.stl" scale="${mm_to_m} ${mm_to_m} ${mm_to_m}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_description/meshes/assemblyart4.stl" scale="${mm_to_m} ${mm_to_m} ${mm_to_m}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
    </link>

    <link name="wrist_2_link">
        <visual>
            <geometry>
                <mesh filename="package://robot_description/meshes/assemblyart5_6.stl" scale="${mm_to_m} ${mm_to_m} ${mm_to_m}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 1.5708" />
            <material name="red" />
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.1585" radius="0.0550" />
            </geometry>
            <origin xyz="0 0 0.0323" rpy="0 0 0" />
        </collision>
    </link>

    <!-- wrist_link is a degenerate intermediate frame coincident with
         wrist_2_link (tool_yaw_joint has zero offset). Adding collision here
         would only duplicate wrist_2_link and create spurious self-collision
         pairs, so it carries no collision geometry. -->
    <link name="wrist_link" />

    <!-- <link name="tool_link">
        <visual>
            <geometry>
                <cylinder length="${tool_link_length}" radius="${tool_link_radius}" />
            </geometry>
            <origin xyz="0 0 ${tool_link_length/2}" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder length="${tool_link_length}" radius="${tool_link_radius}" />
            </geometry>
            <origin xyz="0 0 ${tool_link_length/2}" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="0.2" r="${tool_link_radius}" l="${tool_link_length}" o_xyz="0 0 ${tool_link_length/2}" o_rpy="0 0 0" />
    </link> -->

    <!-- <link name="left_finger">
        <visual>
            <geometry>
                <box size="${finger_length} ${finger_width} ${finger_height}" />
            </geometry>
            <origin xyz="0 0 ${finger_length/2}" rpy="0 1.5708 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${finger_length} ${finger_width} ${finger_height}" />
            </geometry>
            <origin xyz="0 0 ${finger_length/2}" rpy="0 1.5708 0" />
        </collision>
        <xacro:box_inertia m="0.05" x="${finger_length}" y="${finger_width}" z="${finger_height}" o_xyz="0 0 ${finger_length/2}" o_rpy="0 1.5708 0" />
    </link> -->

    <!-- <link name="right_finger">
        <visual>
            <geometry>
                <box size="${finger_length} ${finger_width} ${finger_height}" />
            </geometry>
            <origin xyz="0 0 ${finger_length/2}" rpy="0 1.5708 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${finger_length} ${finger_width} ${finger_height}" />
            </geometry>
            <origin xyz="0 0 ${finger_length/2}" rpy="0 1.5708 0" />
        </collision>
        <xacro:box_inertia m="0.05" x="${finger_length}" y="${finger_width}" z="${finger_height}" o_xyz="0 0 ${finger_length/2}" o_rpy="0 1.5708 0" />
    </link> -->

    <link name="ee_link" />






    <joint name="base_yaw_joint" type="revolute">
        <parent link="base_link" />
        <child link="link_1" />
        <origin xyz="0 0 0.079" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="-3.1416" upper="3.1416" effort="20" velocity="1.5"/>
    </joint>

    <joint name="shoulder_roll_joint" type="revolute">
        <parent link="link_1" />
        <child link="link_2" />
        <origin xyz="0 -0.068 0.123" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="-1.7200" upper="1.7200" effort="20" velocity="1.5"/>
    </joint>

    <joint name="elbow_roll_joint" type="revolute">
        <parent link="link_2" />
        <child link="link_3" />
        <origin xyz="0 0.068 0.16" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="-1.7200" upper="1.7200" effort="20" velocity="1.5"/>
    </joint>


    <joint name="wrist_yaw_joint" type="revolute">
        <parent link="link_3" />
        <child link="link_4" />
        <origin xyz="0 0 0.0825" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="-3.1416" upper="3.1416" effort="15" velocity="1.5"/>
    </joint>

    <joint name="wrist_roll_joint" type="revolute">
        <parent link="link_4" />
        <child link="wrist_link" />
        <origin xyz="0 0 0.1115" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="-1.410" upper="1.410" effort="8" velocity="2.0"/>
    </joint>

    <joint name="tool_yaw_joint" type="revolute">
        <parent link="wrist_link" />
        <child link="wrist_2_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="-3.1416" upper="3.1416" effort="8" velocity="2.0"/>
    </joint>

    <!-- <joint name="left_gripper_finger_joint" type="fixed">
        <parent link="wrist_2_link" />
        <child link="left_finger" />
        <origin xyz="0 ${finger_gap} ${wrist_2_link_length}" rpy="0 0 0" />
    </joint>

    <joint name="right_gripper_finger_joint" type="fixed">
        <parent link="wrist_2_link" />
        <child link="right_finger" />
        <origin xyz="0 ${-finger_gap} ${wrist_2_link_length}" rpy="0 0 0" />
    </joint>  -->

    <joint name="ee_fixed_joint" type="fixed">
        <parent link="wrist_2_link" />
        <child link="ee_link" />
        <origin xyz="0 0 0.1115" rpy="0 0 0" />
    </joint>


    <link name="tool_link" />

    <joint name="tool_fixed_joint" type="fixed">
        <parent link="ee_link" />
        <child link="tool_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

</robot>
