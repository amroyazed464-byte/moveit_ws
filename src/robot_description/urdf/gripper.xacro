<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


    <link name="gripper_base">
        <visual>
            <geometry>
                <box size="0.107 0.02482 0.002" />
            </geometry>
            <origin xyz="0 0 0.001" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="0.107 0.02482 0.002" />
            </geometry>
            <origin xyz="0 0 0.001" rpy="0 0 0" />
        </collision>
    </link>


    <link name="gripper_finger_left">
        <visual>
            <geometry>
                <box size="0.01861 0.01550 0.03571" />
            </geometry>
            <origin xyz="-0.04419 0.00466 0.01785" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="0.01861 0.01550 0.03571" />
            </geometry>
            <origin xyz="-0.04419 0.00466 0.01785" rpy="0 0 0" />
        </collision>
    </link>

    <link name="gripper_finger_right">
        <visual>
            <geometry>
                <box size="0.01861 0.01550 0.03571" />
            </geometry>
            <origin xyz="0.04419 0.00466 0.01785" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="0.01861 0.01550 0.03571" />
            </geometry>
            <origin xyz="0.04419 0.00466 0.01785" rpy="0 0 0" />
        </collision>
    </link>

    <joint name="gripper_finger_left_joint" type="prismatic">
        <parent link="gripper_base" />
        <child link="gripper_finger_left" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <limit lower="0" upper="0.034" effort="20" velocity="0.1" />
    </joint>

    <joint name="gripper_finger_right_joint" type="prismatic">
        <parent link="gripper_base" />
        <child link="gripper_finger_right" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <mimic joint="gripper_finger_left_joint" multiplier="-1.0"/>
        <limit lower="-0.034" upper="0" effort="20" velocity="0.1" />
    </joint>
 
 
</robot>
